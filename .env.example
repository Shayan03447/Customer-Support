# Copy to .env and fill in. .env is gitignored.

# --- Postgres (docker-compose) ---
POSTGRES_PASSWORD=change-me
# From the host, the DB is on 5433. From inside n8n's container it is
# cs-postgres:5432 (both containers share the n8n_default network).
DATABASE_URL=postgresql://salonbot:change-me@localhost:5433/salonbot

# --- OpenAI ---
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small

# --- Meta ---
META_APP_SECRET=
META_VERIFY_TOKEN=
