      "id": "dc7cd29a-3e2b-41b3-b6dc-7263976378b3",
      "name": "Meta Webhook (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -64,
        368
      ],
      "webhookId": "a1000000-0000-4000-8000-000000000010"
    },
    {
      "parameters": {
        "jsCode": "// Reject anything not signed with the Meta app secret. Without this,\n// anyone who learns the URL can inject fake customers into the CRM.\nconst crypto = require('crypto');\nconst item = $input.first();\n\nconst raw = item.binary?.data\n  ? Buffer.from(item.binary.data.data, 'base64').toString('utf8')\n  : JSON.stringify(item.json.body);\n\nconst expected = 'sha256=' + crypto\n  .createHmac('sha256', $env.META_APP_SECRET)\n  .update(raw, 'utf8')\n  .digest('hex');\n\nconst received = item.json.headers['x-hub-signature-256'];\nif (!received || received !== expected) {\n  throw new Error('invalid signature');\n}\n\nreturn [{ json: { body: JSON.parse(raw) } }];"
      },
      "id": "caa33373-8792-4c8d-8b11-cae6c5271d83",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
