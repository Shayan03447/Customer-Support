    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst q = { ...(item.query || {}), ...(item.params || {}), ...item };\nconst token = q['hub.verify_token'];\nconst challenge = q['hub.challenge'];\nconst expected = $env.META_VERIFY_TOKEN;\nif (!expected) throw new Error('META_VERIFY_TOKEN env is empty');\nif (token !== expected) throw new Error('verify token mismatch');\nif (!challenge) throw new Error('missing hub.challenge');\nreturn [{ json: { challenge: String(challenge) } }];"
      },
      "id": "240e1d60-b98a-46d9-8334-b11eba011ba2",
      "name": "Check Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        80
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.challenge }}",
        "options": {}
      },
      "id": "91a61192-68c5-4138-b56d-39954892159e",
      "name": "Return Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
