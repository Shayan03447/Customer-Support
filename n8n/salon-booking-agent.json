    {
      "parameters": {
        "jsCode": "// Flatten Messenger and Instagram into one shape, and drop everything\n// that is not a real inbound message.\nconst body = $input.first().json.body;\nconst out = [];\n\nfor (const entry of body.entry ?? []) {\n  for (const ev of entry.messaging ?? []) {\n    if (ev.message?.is_echo) continue;          // our own message coming back\n    if (!ev.message && !ev.postback) continue;  // reads, deliveries, reactions\n\n    const referral = ev.referral ?? ev.postback?.referral ?? {};\n\n    out.push({ json: {\n      page_id:     entry.id,\n      platform:    body.object === 'instagram' ? 'instagram' : 'messenger',\n      sender_id:   ev.sender.id,\n      message_id:  ev.message?.mid ?? `pb_${ev.sender.id}_${ev.timestamp}`,\n      text:        ev.message?.text ?? ev.postback?.title ?? '',\n      has_media:   Boolean(ev.message?.attachments?.length),\n      // Only present on the first message of an ad-driven thread. If it is\n      // not captured here, ad attribution is lost for good.\n      ad_id:       referral.ad_id ?? null,\n      ad_ref:      referral.ref ?? null,\n      ts:          ev.timestamp,\n    }});\n  }\n}\n\nreturn out;"
      },
      "id": "070c4862-b5d6-42ef-a9cd-95c110c1212d",
